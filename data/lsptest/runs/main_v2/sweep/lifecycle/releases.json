 "rule": {
  "gopls": "the first release (vX.Y.0) of every minor line v0.16 ... v0.23 (the campaign's v0.23.0), plus the newest",
  "rust-analyzer": "the first weekly release (tag YYYY-MM-DD) of each quarter 2024-Q4 ... 2026-Q3, plus the campaign's 2026-09-21 and the newest",
  "ts6": "the last patch of each TypeScript minor 5.5, 5.6, 5.7, 5.8, 5.9 and 6.0, each with the typescript-language-server release newest at that TypeScript release's publication time (npm `time`), plus the campaign pair 6.0.3+tsls6.0.0 and the newest pair",
  "pyright": "the first stable release (npm `time`) of each quarter 2024-Q4 ... 2026-Q3, plus the campaign's 1.1.414 and the newest (as the rust-analyzer rule: both lines release about weekly); installed as the benchmark installs pyright (npm pyright@<v>, scripts/lsptest/bench/install_builds.py)"
 },
 "common": [
  "releases published up to 2026-09-28; 3 replays per group and build; verdicts of version_sweep.verdict",
  "ts6 line through the frozen sweep's kind tsserver (pinned wrapper started with the pinned tsserver.js, no ts6 session settings), as older-2025 and ts_isolation.py; the campaign pair in that kind controls for the kind",
  "gopls builds are compiled and run with the local Go (go1.27.1, the toolchain of the campaign's v0.23.0 build); a release the local Go cannot compile is compiled and run with go1.24.4 (install_builds --go); where the install directory already holds an era-Go benchmark build, the local-Go build goes to gopls-<v>+<go>/",
  "a gopls group is replayed on a build only if the build's Go meets every go directive of the group's project (go.mod/go.work), since the harness runs gopls with GOTOOLCHAIN=local; other pairs are listed under skip",
  "a build that cannot be installed, or fails the launch check (smoke_servers.smoke: initialize, diagnostics and hover on a one-file project), after two attempts is recorded as unavailable",
  "the C2 group (timing race) runs alone; otherwise at most 3 jobs at once (gopls, rust-analyzer, ts6+ts7)"
 ],
