0.5) if not r: if time.time() > deadline: raise TimeoutError continue c = os.read(self.s.fileno(), 65536) if not c: raise EOFError self.buf += c head, self.buf = self.buf.split(b"\r\n\r\n", 1) n = int([l for l in head.split(b"\r\n") if l.lower().startswith(b"content-length")][0].split(b":")[1]) while len(self.buf) < n: r, _, _ = select.select([self.s], [], [], 0.5) if not r: if time.time() > deadline: raise TimeoutError continue c = os.read(self.s.fileno(), 65536) if not c: raise EOFError self.b

