{"t": 571406.3362, "dir": "send", "msg": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://temp/corpus_probe/date-fns__date-fns__f34149bb1ba1__ts6-6.0.3/pkgs/core/examples/cts/test.ts", "languageId": "typescript", "version": 1, "text": "const { addDays, format } = require(\"date-fns\");\nconst { add } = require(\"date-fns/add\");\nconst { addDays: fpAddDays } = require(\"date-fns/fp/addDays\");\n\nconst date = addDays(new Date(2020, 0, 1), 1);\n\nassertEqual(format(date, \"yyyy-MM-dd\"), \"2020-01-02\");\nassertEqual(\n  format(add(new Date(2020, 0, 1), { days: 2 }), \"yyyy-MM-dd\"),\n  \"2020-01-03\",\n);\nassertEqual(\n  format(fpAddDays(3, new Date(2020, 0, 1)), \"yyyy-MM-dd\"),\n  \"2020-01-04\",\n);\n\nfunction assertEqual<Type>(actual: Type, expected: Type) {\n  if (actual === expected) return;\n  throw new Error(`Expected ${expected}, got ${actual}`);\n}\n"}}}}
{"t": 571406.3364, "dir": "send", "msg": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://temp/corpus_probe/date-fns__date-fns__f34149bb1ba1__ts6-6.0.3/pkgs/core/examples/ts/test.ts", "languageId": "typescript", "version": 1, "text": "import { addDays, format } from \"date-fns\";\nimport { add } from \"date-fns/add\";\nimport { addDays as fpAddDays } from \"date-fns/fp/addDays\";\n\nconst date = addDays(new Date(2020, 0, 1), 1);\n\nassertEqual(format(date, \"yyyy-MM-dd\"), \"2020-01-02\");\nassertEqual(\n  format(add(new Date(2020, 0, 1), { days: 2 }), \"yyyy-MM-dd\"),\n  \"2020-01-03\",\n);\nassertEqual(\n  format(fpAddDays(3, new Date(2020, 0, 1)), \"yyyy-MM-dd\"),\n  \"2020-01-04\",\n);\n\nfunction assertEqual<Type>(actual: Type, expected: Type) {\n  if (actual === expected) return;\n  throw new Error(`Expected ${expected}, got ${actual}`);\n}\n"}}}}
