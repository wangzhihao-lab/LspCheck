{"t": 571555.4071, "dir": "send", "msg": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://temp/corpus_probe/virattt__ai-hedge-fund__7d897a002c26__pyright-1.1.414/hedge_fund/__init__.py", "languageId": "python", "version": 1, "text": "\"\"\"AI Hedge Fund v2 \u2014 quantitative trading stack.\n\nA clean-room rebuild focused on quant fundamentals:\ndata pipelines, event studies, backtesting, validation,\nfeature engineering, portfolio construction, risk management,\nand execution simulation.\n\"\"\"\n"}}}}
